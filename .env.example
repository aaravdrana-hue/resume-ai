# Copy this file to `.env.local` and fill in the values.
#   cp .env.example .env.local
#
# `.env.local` is gitignored — never commit real keys.
# Restart `npm run dev` after any change; Next.js only reads env at startup.

# Groq — https://console.groq.com/keys
# Must start with `gsk_`. An OpenAI `sk-` key will NOT work here.
GROQ_API_KEY=

# Supabase — Dashboard → Settings → API
# The project URL is https://<project-ref>.supabase.co
SUPABASE_URL=

# Use the SECRET key (`sb_secret_…`), or the legacy `service_role` key
# (`eyJ…`). The publishable/anon key will not work — it cannot write past RLS.
# Server-side only; this is never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
